# Quantum Nexus Environment Configuration
# Copy this file to .env and fill in your credentials

# === Trading Capital Settings ===
TRADING_CAPITAL=100000.0
RISK_PER_TRADE=2.0
MAX_DAILY_DRAWDOWN=3.0

# === Broker Credentials (AngelOne SmartAPI) ===
ANGEL_CLIENT_ID=your_client_id
ANGEL_API_KEY=your_api_key
ANGEL_SECRET_KEY=your_secret_key
ANGEL_PASSWORD=your_pin
ANGEL_TOTP_SEED=your_totp_seed

# === AI Configuration (Optional) ===
OPENAI_API_KEY=sk-your-openai-key-here

# === Telegram Alerts (Optional) ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Discord Alerts (Optional) ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# === Database ===
DB_PATH=data/brain_memory.db

# === Data Provider ===
DATA_PROVIDER=yfinance
PAPER_TRADING_ENABLED=true
